erDiagram
  usuarios {
    int id PK
    varchar usuario UK
    varchar clave_hash
    varchar nombre_completo
    varchar cargo
    varchar correo
    int rol_id FK
    int colaborador_id FK
    tinyint debe_cambiar_clave
    tinyint intentos_fallidos
    datetime bloqueado_hasta
    int version_sesion
    datetime clave_cambiada_en
    varchar totp_secreto
    tinyint totp_activo
    text totp_respaldo
    bigint totp_ultimo_paso
    datetime ultimo_acceso
  }
  historial_claves {
    int id PK
    int usuario_id FK
    varchar clave_hash
    datetime creado_en
  }
  textos_legales {
    int id PK
    enum tipo
    smallint version
    text texto
    tinyint vigente
    int creado_por FK
  }
  aceptaciones_legales {
    int id PK
    int usuario_id FK
    int texto_id FK
    datetime aceptado_en
    varchar ip
  }
  roles {
    int id PK
    varchar codigo UK
    varchar nombre
    varchar descripcion
  }
  permisos {
    int id PK
    varchar codigo UK
    varchar modulo
    varchar descripcion
  }
  rol_permisos {
    int rol_id PK,FK
    int permiso_id PK,FK
  }
  auditoria {
    bigint id PK
    datetime fecha
    int usuario_id FK
    enum accion
    varchar tabla
    int registro_id
    longtext datos_antes
    longtext datos_despues
    varchar ip
  }
  alertas {
    bigint id PK
    enum tipo
    enum rol_destino
    int colaborador_id FK
    varchar referencia_tabla
    int referencia_id
    date fecha_evento
    varchar mensaje
    enum estado
    datetime generada_en
    int atendida_por FK
    datetime atendida_en
    varchar motivo_descarte
  }
  colaboradores {
    int id PK
    varchar nombres
    varchar apellidos
  }
  roles ||--o{ usuarios : "rol_id"
  colaboradores |o--o{ usuarios : "colaborador_id"
  roles ||--o{ rol_permisos : "rol_id"
  permisos ||--o{ rol_permisos : "permiso_id"
  usuarios |o--o{ auditoria : "usuario_id"
  colaboradores |o--o{ alertas : "colaborador_id"
  usuarios |o--o{ alertas : "atendida_por"
  usuarios ||--o{ historial_claves : "usuario_id"
  usuarios ||--o{ aceptaciones_legales : "usuario_id"
  textos_legales ||--o{ aceptaciones_legales : "texto_id"
  usuarios |o--o{ textos_legales : "creado_por"
