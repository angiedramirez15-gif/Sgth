# Copiar este archivo como .env y completar los valores.
# El archivo .env NUNCA se sube a GitHub (está en .gitignore).

# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- Base de datos MariaDB (usuario creado con 03_usuario_aplicacion.sql) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sgth
DB_USER=sgth_app
DB_PASSWORD=escriba_aqui_la_clave_de_sgth_app

# --- Sesión ---
# Texto aleatorio de al menos 32 caracteres. Para generarlo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# También protege el secreto de la doble verificación: si se cambia, cada usuario
# debe volver a activarla (el administrador la reinicia en Usuarios).
JWT_SECRETO=
# La sesión vence con los minutos de inactividad de Configuración (máximo 12 horas).

# --- HTTPS (candado). Se completa en la Fase 7 con el certificado del servidor ---
# HTTPS_PFX=C:\SGTH\certificado\sgth.pfx
# HTTPS_PFX_CLAVE=clave_del_certificado
#   o bien:
# HTTPS_CERT=C:\SGTH\certificado\sgth.crt
# HTTPS_KEY=C:\SGTH\certificado\sgth.key
# Quien entre por http://servidor pasa a https (opcional):
# HTTP_REDIRECCION_PUERTO=80

# --- Archivos (documentos, actas, fotos) ---
# Por defecto se usa la carpeta configurada en el sistema: C:\SGTH\archivos
# ARCHIVOS_DIR=C:\SGTH\archivos

# --- Frontend compilado (solo producción) ---
# FRONTEND_DIST=../frontend/dist/frontend/browser
